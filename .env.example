# TARS Daemon Configuration
# RPi runs as a standalone WebRTC server, waiting for AI brain connections

# API Port
API_PORT=8001

# WebRTC Server (set to false for REST API only)
WEBRTC_ENABLED=true

# Display (set to false for headless operation)
DISPLAY_ENABLED=true
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480

# Face Tracking (optional - follows faces with eyes)
FACE_TRACKING_ENABLED=false

# Audio devices (optional - uses default if not specified)
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SAMPLE_RATE_IN=16000
AUDIO_SAMPLE_RATE_OUT=24000
