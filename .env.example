# TARS Daemon Configuration

# Host Computer connection (optional - leave empty for standalone mode)
# Example: http://100.64.0.1:7860 (Tailscale IP)
# Works with macOS, Windows, or Linux
HOST_URL=

# API Port
API_PORT=8001

# Display (set to false for headless operation)
DISPLAY_ENABLED=true
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480

# Audio devices (optional - uses default if not specified)
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SAMPLE_RATE_IN=16000
AUDIO_SAMPLE_RATE_OUT=24000
