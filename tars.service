[Unit]
Description=TARS Robot Hardware Daemon
Documentation=https://github.com/latishab/tars
After=network-online.target sound.target
Wants=network-online.target

# NOTE: Update User, Group, WorkingDirectory, and all /home/mac/tars-daemon
# paths below to match your system. Replace "mac" with your Pi username
# and "tars-daemon" with your install directory name.

[Service]
Type=simple
User=mac
Group=mac
WorkingDirectory=/home/mac/tars-daemon

# Environment
Environment="PATH=/home/mac/tars-daemon/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="DISPLAY=:0"
Environment="SDL_VIDEODRIVER=x11"
Environment="XAUTHORITY=/home/mac/.Xauthority"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
EnvironmentFile=-/home/mac/tars-daemon/.env

# Start daemon with start.sh script (handles venv activation and argument parsing)
ExecStart=/home/mac/tars-daemon/start.sh

# Restart policy
Restart=on-failure
RestartSec=2
StartLimitBurst=5
StartLimitIntervalSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tars

# Security (optional hardening)
# NoNewPrivileges=true
# PrivateTmp=true

# Graceful shutdown
TimeoutStopSec=5
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
