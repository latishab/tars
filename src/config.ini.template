# ============================================
# TARS Control System V3 Configuration
# ============================================
# This is the template configuration for the minimal movement-only service.
# Copy this file to config.ini and adjust values for your hardware setup.
#
# IMPORTANT: Use app-servotester.py to calibrate servo values!
# Do NOT manually edit servo values unless you know what you're doing.

[CONTROLS] # Bluetooth Controller Settings
controller_name = 8BitDo
# Name of the controller used for interaction (e.g., 8BitDo, Xbox, PS4)
enabled = False
# Enable or disable Bluetooth controller input
voicemovement = False
# Enable or disable movement via voice control 
swap_turn_directions = False
# Swap left/right turn directions if controller feels inverted
invert_y = False
# Invert D-Pad Y axis if up/down feels reversed

# [UI] section removed - not used by current apps
# The servotester app (app-servotester.py) does not require UI configuration
# All UI settings are handled internally by the app

[SERVO]
# ============================================
# Servo Controller V3 Configuration
# ============================================
# CRITICAL: Use app-servotester.py to calibrate these values!
# Manual editing can cause servo damage or mechanical strain.
#
# Hardware Setup:
# - Servo 0: Left leg height control
# - Servo 1: Right leg height control
# - Servo 2: Left leg forward/backward position
# - Servo 3: Right leg forward/backward position
#
# Use app-servotester.py to adjust these values!

# Servo 0: Left Leg Height
leftUpHeight = 220
# PWM value for left leg fully raised position
leftDownHeight = 460
# PWM value for left leg fully lowered position
perfectLeftHeightOffset = 0
# Fine-tuning offset for left leg height (adjust via servo tester)

# Servo 1: Right Leg Height
rightUpHeight = 460
# PWM value for right leg fully raised position
rightDownHeight = 220
# PWM value for right leg fully lowered position
perfectRightHeightOffset = 0
# Fine-tuning offset for right leg height (adjust via servo tester)

# Servo 2: Left Leg Forward/Backward
forwardLeftLeg = 160
# PWM value for left leg fully forward position
backLeftLeg = 460
# PWM value for left leg fully backward position
perfectLeftLegOffset = 0
# Fine-tuning offset for left leg position (adjust via servo tester)

# Servo 3: Right Leg Forward/Backward
forwardRightLeg = 460
# PWM value for right leg fully forward position
backRightLeg = 160
# PWM value for right leg fully backward position
perfectRightLegOffset = 0
# Fine-tuning offset for right leg position (adjust via servo tester)

[BATTERY]
# ============================================
# INA260 Current/Voltage/Power Sensor
# ============================================
# Optional: Only required if using INA260 sensor for battery monitoring
# These values must match your specific battery specifications

battery_capacity_mAh = 3400
# Total battery capacity in milliampere-hours (mAh)
# Example: 3000 mAh for a 3.0Ah battery, 5600 mAh for a 5.6Ah battery

battery_initial_voltage = 12
# Full charge voltage in volts
# Example: 12.6V for a fully charged 12V LiPo battery

battery_cutoff_voltage = 10
# Minimum safe discharge voltage in volts
# Example: 10.5V for a 12V battery (prevents over-discharge damage)

auto_shutdown = True
# Automatically shutdown Raspberry Pi when battery reaches 0%
# Protects both the Pi and battery from damage

[MISC]
# ============================================
# Miscellaneous Settings
# ============================================

ventilate = False
# Enable automatic ventilation pose
# When True, robot periodically assumes a pose that improves airflow
# Useful for preventing overheating during extended operation
